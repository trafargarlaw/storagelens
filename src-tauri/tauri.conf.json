{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "StorageLens",
	"version": "0.2.7",
	"identifier": "io.storagelens.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "StorageLens",
				"decorations": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"width": 1100,
				"height": 700,
				"minWidth": 800,
				"minHeight": 500
			}
		],
		"security": {
			"csp": null,
			"capabilities": [
				"default",
				{
					"identifier": "draggable-window",
					"windows": ["*"],
					"permissions": ["core:window:allow-start-dragging"]
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["dmg", "app"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"signingIdentity": "Developer ID Application",
			"hardenedRuntime": true
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyMDlFNjNDNkFDOUZGNzYKUldSMi84bHFQT1lKQXN4cTZHSlA5UDJDZEcrd0Fsbm9RYlhXcE9IbEdQVWx6TElOWjZiZG04YVEK",
			"endpoints": [
				"https://github.com/trafargarlaw/disk-scanner/releases/latest/download/latest.json"
			]
		}
	}
}
